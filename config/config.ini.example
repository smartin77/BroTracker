; Optional host settings. Merge into an existing user config; never overwrite it.
; Windows: %APPDATA%/BroTracker/BroTracker Terminal/config.ini
; ArkOS/dArkOS: $XDG_DATA_HOME/BroTracker/BroTracker Terminal/config.ini
; If XDG_DATA_HOME is unset: $HOME/.local/share/BroTracker/BroTracker Terminal/config.ini
; Restart BTX to reload. Restart Teensy to change an already activated route.
[btx]
schema_version=1
new_pattern_length=32

[logging]
mode=debug
preserve_last=5

; Note and numeric Instrument fields; OFF timing toggles are unaffected.
; normal: PgUp increases, PgDn decreases. reversed: opposite value direction.
; Deprecated alias: note_step_direction. Do not specify both names.
[editing]
value_step_direction=normal

; Selects Teensy output, not the host playback device. Restart Teensy to change an active route.
[audio]
output=bridge

; External MIDI: decimal 1-16; empty/missing/invalid uses 12.
[midi]
output_channel=12
