; Optional host settings. Copy manually to the documented user config path.
[btx]
schema_version=1
new_pattern_length=32

[logging]
mode=debug
preserve_last=5

; Note field only; instrument values and OFF timing toggles are unaffected.
; normal: PgUp increases, PgDn decreases. reversed: opposite note direction.
[editing]
note_step_direction=normal
