; Optional host settings. Copy manually to the documented user config path.
[btx]
schema_version=1
new_pattern_length=32

[logging]
mode=debug
preserve_last=5

; Note and numeric Instrument fields; OFF timing toggles are unaffected.
; normal: PgUp increases, PgDn decreases. reversed: opposite value direction.
; Deprecated alias: note_step_direction. Do not specify both names.
[editing]
value_step_direction=normal
