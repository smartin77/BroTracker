{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build and Run",
            "type": "shell",
            "command": "cmake --build build && ./build/BroTracker.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake Build and Test",
            "type": "shell",
            "command": "cmake --build build && ctest --test-dir build --output-on-failure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
